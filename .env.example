NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_db

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin (used by npm run seed)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@inventory.com
ADMIN_PASSWORD=Admin@12345

# Local image uploads (optional — defaults shown)
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE=2097152
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
