NODE_ENV=development
PORT=5000

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,https://kglowskincare.kglowskincarekorea.com

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_db

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin (used by npm run seed)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@inventory.com
ADMIN_PASSWORD=Admin@12345

# Local image uploads (fallback when R2 is not configured)
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_FILE_SIZE=2097152
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Cloudflare R2 (optional — when all values are set, uploads go to R2)
# Requires R2_PUBLIC_URL (r2.dev or custom domain) or uploads stay LOCAL.
STORAGE_PROVIDER=r2
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
R2_REGION=auto

# Company branding for invoice PDFs (optional)
COMPANY_NAME=K Glow Skin Care
COMPANY_ADDRESS=123 Business Street, Suite 100
# Phone is optional and is not shown on invoice PDFs
COMPANY_PHONE=
COMPANY_EMAIL=billing@inventory.com
COMPANY_LOGO_PATH=
COMPANY_FOOTER=Thank you for your business.
