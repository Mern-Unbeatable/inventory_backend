    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('productId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Vitamin C Brightening Serum\",\n  \"sku\": \"SKN-VITC-001\",\n  \"description\": \"Antioxidant serum for dull skin\",\n  \"price\": 19.99\n}"
            },
            "url": "{{baseUrl}}/products",
            "description": "Admin only. JSON body without image."
          }
        },
        {
          "name": "Create Product (with Image)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('productId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Hydrating Face Cream", "type": "text" },
                { "key": "sku", "value": "SKN-CRM-002", "type": "text" },
                { "key": "description", "value": "Daily moisturizer", "type": "text" },
                { "key": "price", "value": "24.50", "type": "text" },
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Select a jpg/png/webp file (max ~2MB)"
                }
              ]
            },
            "url": "{{baseUrl}}/products",
            "description": "Admin only. multipart/form-data. Field `image` is optional. Allowed: jpg, jpeg, png, webp."
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "serum", "disabled": true },
                { "key": "minPrice", "value": "0", "disabled": true },
                { "key": "maxPrice", "value": "50", "disabled": true }
              ]
            },
