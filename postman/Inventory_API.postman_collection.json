              "raw": "{\n  \"name\": \"Branch Seller\",\n  \"email\": \"seller.new@inventory.com\",\n  \"password\": \"Seller@12345\",\n  \"role\": \"SELLER\",\n  \"branchId\": \"{{branchId}}\"\n}"
            },
            "url": "{{baseUrl}}/users"
