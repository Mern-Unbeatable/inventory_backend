              ]
            },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Also deletes the product image file if present."
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Assign Product to User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('inventoryId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 50\n}"
            },
            "url": "{{baseUrl}}/inventory/assign",
            "description": "Admin only. Assigns a catalog product to a SELLER with starting quantity."
          }
        },
        {
          "name": "List Inventory (Admin filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventory?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["inventory"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "countryId", "value": "{{countryId}}", "disabled": true },
                { "key": "branchId", "value": "{{branchId}}", "disabled": true },
                { "key": "userId", "value": "{{userId}}", "disabled": true },
                { "key": "productId", "value": "{{productId}}", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "My Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/me"
          }
        },
        {
          "name": "Get User Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/user/{{userId}}",
            "description": "Admin: any user. Seller: own userId only. Returns items + summary."
          }
        },
        {
          "name": "Get Inventory Record",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/{{inventoryId}}"
          }
        },
        {
          "name": "Set Quantity (absolute)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 75\n}"
            },
            "url": "{{baseUrl}}/inventory/{{inventoryId}}/quantity"
          }
        },
        {
          "name": "Adjust Quantity (delta)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": -5\n}"
            },
            "url": "{{baseUrl}}/inventory/{{inventoryId}}/adjust"
          }
        },
        {
          "name": "Record Sale",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/inventory/{{inventoryId}}/sell",
            "description": "Admin or owning seller. Decreases stock and creates a Sale (revenue = qty × product price). Fails if quantity exceeds available stock."
          }
        },
        {
          "name": "Unassign Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/inventory/{{inventoryId}}"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard/overview",
            "description": "Role-aware. Admin: global totals + countryBreakdown + recentSales. Seller: own stock/revenue summary."
          }
        }
      ]
    }
