{
  "name": "inventory-management-api",
  "version": "1.0.0",
  "description": "Multi-Country & Multi-Branch Inventory Management System API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "seed:reset": "node src/seed.js --reset",
    "db:setup": "npm run seed",
    "db:reset": "npm run seed:reset"
  },
  "keywords": [
    "inventory",
    "express",
    "mongoose",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.19.1",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
